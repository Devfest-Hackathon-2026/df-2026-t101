{
  "firestore": { "rules": "firebase/firestore.rules", "indexes": "firebase/firestore.indexes.json" },
  "storage": { "rules": "firebase/storage.rules" },
  "hosting": {
    "public": "app/build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      { "source": "**/*.@(wasm|task|js)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  },
  "emulators": { "firestore": { "port": 8180 }, "storage": { "port": 9199 }, "auth": { "port": 9099 }, "ui": { "enabled": true } }
}
